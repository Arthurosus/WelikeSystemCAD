### Criar empresa de teste
POST http://localhost:8000/empresas/
Content-Type: application/json

{
  "codigo":            "EMP001",
  "cnpj":              "12345678000190",
  "inscricao_municipal":"12345",
  "inscricao_estadual": "987654321",
  "razao_social":       "Empresa Teste Ltda",
  "nome_fantasia":      "Empresa Teste",
  "sigla":              "ETL",
  "nome_site":          "empresa‑teste",

  "tipo_empresa":       "Própria",
  "regime_empresarial": "Simples",
  "estado_empresa":     "Ativa",

  "telefones": [
    { "numero": "11999990000", "principal": true, "whatsapp": true }
  ],

  "redes_sociais": {
    "email":     "contato@empresa‑teste.com",
    "instagram": "empresa_teste"
  },

  "endereco": {
    "formato":  "brasil",
    "cep":      "01001000",
    "rua":      "Rua Exemplo",
    "numero":   "123",
    "bairro":   "Centro",
    "cidade":   "São Paulo",
    "estado":   "SP",
    "pais":     "Brasil"
  }
}
